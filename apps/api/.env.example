PORT=3000
NODE_ENV=development
# Em staging/production, use true para exigir JWT mesmo fora de production.
DURTONE_AUTH_REQUIRED=false
DASHBOARD_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:durtone_dev_password@localhost:55432/durtone
DURTONE_TENANT_ID=00000000-0000-0000-0000-000000000001
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=redis://localhost:56379
DURTONE_RATE_LIMIT_WINDOW_SECONDS=60
DURTONE_RATE_LIMIT_MAX=120
# Master key for encrypting cloud/identity provider credentials at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
# Fly.io API token with access to the edge proxy app, and that app's name - used to
# request/check/delete TLS certificates for customer domains via the Machines API.
# Without these, domains are created but stay in pending_dns with an error noting it.
FLY_API_TOKEN=
FLY_APP_NAME=
# Shared secret between this API and the apps/durtwall edge fleet - authenticates
# GET /api/v1/edge/routing-table and the fleet-mode path of POST /api/v1/ingest/logs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EDGE_FLEET_TOKEN=