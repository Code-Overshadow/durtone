# Direct Postgres access - the worker reads cloud_accounts and writes scans/drifts itself,
# it does not go through the Control Plane API or an agent enrollment token.
DATABASE_URL=

# Must match the Control Plane's CREDENTIAL_ENCRYPTION_KEY - this worker decrypts
# cloud_accounts.credential_ref written by the dashboard/API.
CREDENTIAL_ENCRYPTION_KEY=

# How often (ms) to check for cloud accounts due for a scan.
DURTGUARDIAN_INTERVAL_MS=300000

# How long (ms) a cloud account can go unscanned before it's picked up again.
# Defaults to DURTGUARDIAN_INTERVAL_MS when unset.
DURTGUARDIAN_STALE_MS=
