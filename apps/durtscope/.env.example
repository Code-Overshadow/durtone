# Direct Postgres access - the worker reads identity_providers and writes identities itself,
# it does not go through the Control Plane API or an agent enrollment token.
DATABASE_URL=

# Must match the Control Plane's CREDENTIAL_ENCRYPTION_KEY - this worker decrypts
# identity_providers.credential_ref written by the dashboard/API.
CREDENTIAL_ENCRYPTION_KEY=

# How often (ms) to check for identity providers due for a sync.
DURTSCOPE_INTERVAL_MS=300000

# How long (ms) a provider can go unsynced before it's picked up again.
# Defaults to DURTSCOPE_INTERVAL_MS when unset.
DURTSCOPE_STALE_MS=
