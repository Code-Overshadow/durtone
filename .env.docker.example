# Copie este arquivo para .env.docker (ja gitignored) antes de rodar
# `bun run docker:local`. Todo o resto (DATABASE_URL, CREDENTIAL_ENCRYPTION_KEY,
# EDGE_FLEET_TOKEN, etc.) fica direto no docker-compose.local.yml porque sao
# valores de uso puramente local, sem nenhum significado fora dessa stack -
# so os 3 valores abaixo sao credenciais reais (do mesmo projeto Supabase que
# apps/api/.env.local ja usa) e por isso nunca vao pro compose nem pro git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
