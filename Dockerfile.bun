# Shared image for the Bun workspace apps (apps/api, apps/durtguardian, apps/durtscope).
# They all depend on packages/* via `workspace:*`, so the build context is the repo root,
# not the individual app directory - `bun install` needs every workspace package.json to
# resolve the lockfile correctly. Which app actually runs is picked by APP_DIR.
#
# Build (from the repo root): docker build -f Dockerfile.bun --build-arg APP_DIR=apps/api .
FROM oven/bun:1 AS runtime
WORKDIR /repo

COPY . .
RUN bun install --frozen-lockfile --production

ARG APP_DIR
ENV APP_DIR=${APP_DIR} NODE_ENV=production
WORKDIR /repo/${APP_DIR}

CMD ["bun", "src/index.ts"]
